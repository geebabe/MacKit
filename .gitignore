# MacKit — .gitignore

# Build products & distributions
.build/
dist/
*.o
*.d
*.dylib
*.app

# Databases, local stores & logs
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db
*.db-wal
*.db-shm
*.enc
*.log
*.tmp
*.crash
*.ips

# Secrets & Local environments
.env
.env.*
*.key
*.pem

# Xcode & Developer Tools
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/
*.xccheckout
*.moved-aside

# SPM
.swiftpm/
Package.resolved

# macOS system files
.DS_Store
.AppleDouble
.LSOverride
._*

# Editors & Tooling
.idea/
.codegraph/
.vscode/
*.swp
*~
